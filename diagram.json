{
  "version": 1,
  "author": "Lab 4.2 - DC Motor Control (L298N simulat cu LED PWM)",
  "editor": "wokwi",
  "parts": [
    { "type": "wokwi-arduino-mega", "id": "mega", "top": 300, "left": 0, "attrs": {} },
    {
      "type": "wokwi-lcd1602",
      "id": "lcd1",
      "top": 0,
      "left": -290,
      "attrs": { "pins": "i2c", "i2c-address": "0x27" }
    },
    {
      "type": "wokwi-led",
      "id": "led_pwm",
      "top": 50,
      "left": 350,
      "attrs": { "color": "green", "label": "Motor speed (PWM)" }
    },
    {
      "type": "wokwi-resistor",
      "id": "r1",
      "top": 145,
      "left": 345,
      "rotate": 90,
      "attrs": { "value": "220" }
    }
  ],
  "connections": [
    [ "lcd1:VCC", "mega:5V",    "red",    [ "h-40", "v240", "h460" ] ],
    [ "lcd1:GND", "mega:GND.1", "black",  [ "h-50", "v260", "h450" ] ],
    [ "lcd1:SDA", "mega:20",    "blue",   [ "h-30", "v180", "h660" ] ],
    [ "lcd1:SCL", "mega:21",    "purple", [ "h-20", "v160", "h650" ] ],

    [ "mega:9",     "r1:1",      "orange", [ "v-20", "h200" ] ],
    [ "r1:2",       "led_pwm:A", "orange", [] ],
    [ "led_pwm:C",  "mega:GND.2","black",  [ "h-10", "v340" ] ]
  ],
  "dependencies": {}
}