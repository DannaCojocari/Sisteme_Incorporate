{
  "version": 1,
  "author": "Lab 6.1 – FSM Button-LED (Moore)",
  "editor": "wokwi",
  "parts": [
    {
      "type": "wokwi-arduino-mega",
      "id": "mega",
      "top": 200,
      "left": 0,
      "attrs": {}
    },
    {
      "type": "wokwi-pushbutton",
      "id": "btn1",
      "top": 20,
      "left": 40,
      "attrs": { "color": "green" }
    },
    {
      "type": "wokwi-led",
      "id": "led_green",
      "top": 20,
      "left": 220,
      "attrs": { "color": "green", "label": "FSM LED" }
    },
    {
      "type": "wokwi-resistor",
      "id": "r_led",
      "top": 80,
      "left": 220,
      "attrs": { "value": "220" }
    },
    {
      "type": "wokwi-lcd1602",
      "id": "lcd1",
      "top": 20,
      "left": 380,
      "attrs": { "pins": "i2c", "address": "0x27" }
    }
  ],
  "connections": [
    ["btn1:1.l", "mega:2",     "green", []],
    ["btn1:2.l", "mega:GND.1", "black", []],

    ["mega:13",      "r_led:1",     "green", []],
    ["r_led:2",      "led_green:A", "green", []],
    ["led_green:C",  "mega:GND.1",  "black", []],

    ["mega:20",   "lcd1:SDA", "green", []],
    ["mega:21",   "lcd1:SCL", "blue",  []],
    ["mega:5V",   "lcd1:VCC", "red",   []],
    ["mega:GND.1","lcd1:GND", "black", []]
  ]
}