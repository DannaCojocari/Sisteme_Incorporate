{
  "version": 1,
  "author": "Lab 5.2 – PID Temperature Control (Wokwi)",
  "editor": "wokwi",
  "parts": [
    {
      "type": "wokwi-arduino-mega",
      "id": "mega",
      "top": 200,
      "left": 0,
      "attrs": {}
    },
    {
      "type": "wokwi-dht22",
      "id": "dht1",
      "top": 0,
      "left": 40,
      "attrs": { "temperature": "22", "humidity": "50" }
    },
    {
      "type": "wokwi-lcd1602",
      "id": "lcd1",
      "top": 0,
      "left": 200,
      "attrs": { "pins": "i2c", "address": "0x27" }
    },
    {
      "type": "wokwi-dc-motor",
      "id": "motor1",
      "top": 0,
      "left": 530,
      "attrs": { "label": "FAN (racire)" }
    },
    {
      "type": "wokwi-led",
      "id": "led_heater",
      "top": 130,
      "left": 530,
      "attrs": { "color": "red", "label": "HEATER" }
    },
    {
      "type": "wokwi-resistor",
      "id": "r1",
      "top": 170,
      "left": 490,
      "attrs": { "value": "220" }
    }
  ],
  "connections": [
    ["mega:GND.1",    "mega:GND.2",     "black",  []],

    ["dht1:VCC",      "mega:5V",        "red",    ["h-10","v60","h-30"]],
    ["dht1:SDA",      "mega:17",        "green",  ["v10","h-20"]],
    ["dht1:GND",      "mega:GND.1",     "black",  ["v20","h-50"]],

    ["mega:20",       "lcd1:SDA",       "green",  []],
    ["mega:21",       "lcd1:SCL",       "blue",   []],
    ["mega:5V",       "lcd1:VCC",       "red",    []],
    ["mega:GND.1",    "lcd1:GND",       "black",  []],

    ["mega:6",        "motor1:A+",      "orange", []],
    ["mega:4",        "motor1:A-",      "yellow", []],
    ["mega:5",        "mega:GND.2",     "black",  []],

    ["mega:7",        "r1:1",           "red",    []],
    ["r1:2",          "led_heater:A",   "red",    []],
    ["led_heater:C",  "mega:GND.1",     "black",  []]
  ]
}